# Database Configuration
DB_HOST=           # Veritabanının barındırıldığı sunucunun adresi (ör. localhost veya bir IP adresi).
DB_PORT=5432       # PostgreSQL bağlantı portu (varsayılan 5432).
DB_USERNAME=       # Veritabanına bağlanmak için kullanılan kullanıcı adı.
DB_PASSWORD=       # Veritabanına bağlanmak için kullanılan şifre.
DB_DATABASE=       # Veritabanının adı.
DB_DROP_SCHEMA=false # true yapılırsa uygulama açılışında şema silinip yeniden oluşturulur.

# JWT Configuration
JWT_SECRET=        # JWT (JSON Web Token) için kullanılan gizli anahtar. Uygulamanın kullanıcı oturumlarını güvenli bir şekilde yönetmesini sağlar.

# Email Configuration
EMAIL_HOST=        # E-posta sunucusunun adresi (ör. mail.example.com).
EMAIL_PORT=        # E-posta sunucusunun port numarası (ör. genelde 587 kullanılır).
EMAIL_USER=        # E-posta göndermek için kullanılan kullanıcı adı (genellikle bir e-posta adresi olur).
EMAIL_PASS=        # E-posta göndermek için kullanılan şifre.

# Application Configuration
APP_URL=           # Uygulamanın temel URL'si (ör. http://localhost:3000, https://example.com).

# Notification Cost Configuration
NOTIFICATION_COST_CURRENCY=USD # Bildirim maliyeti için varsayılan para birimi.
NOTIFICATION_COST_IN_APP_MINOR_UNIT=0 # In-app bildirim başına maliyet (minor unit).
NOTIFICATION_COST_PUSH_MINOR_UNIT=1   # Push bildirim başına maliyet (minor unit).
NOTIFICATION_COST_EMAIL_MINOR_UNIT=2  # Email bildirim başına maliyet (minor unit).

# Google OAuth Configuration
GOOGLE_CLIENT_ID=  # Google API üzerinden OAuth 2.0 doğrulaması için gereken istemci kimliği.
GOOGLE_CLIENT_SECRET= # Google API üzerinden OAuth 2.0 doğrulaması için gereken istemci sırrı.
GOOGLE_CALLBACK_URL=  # Google'dan doğrulama döndüğünde çağrılacak URL.

# Additional Secrets
SECRET_KEY=        # Uygulama genelinde kullanılan ek bir gizli anahtar.

# Billing Store Configuration
BILLING_DEMO_MODE=true # true ise Google/App Store demo doğrulama modunda çalışır.
BILLING_GOOGLE_PLAY_PACKAGE_NAME= # Google Play package name (com.example.app).
BILLING_APP_STORE_BUNDLE_ID= # App Store bundle id (com.example.app).
BILLING_APP_STORE_SHARED_SECRET= # App Store shared secret.
BILLING_GOOGLE_PLAY_WEBHOOK_SECRET= # Google Play webhook HMAC secret.
BILLING_APP_STORE_WEBHOOK_SECRET= # App Store webhook HMAC secret.

# Store Product IDs (PlanCode ↔ productId)
BILLING_GOOGLE_PLAY_PRODUCT_ID_FREE=
BILLING_GOOGLE_PLAY_PRODUCT_ID_STARTER=
BILLING_GOOGLE_PLAY_PRODUCT_ID_PRO=
BILLING_GOOGLE_PLAY_PRODUCT_ID_ENTERPRISE=
BILLING_APP_STORE_PRODUCT_ID_FREE=
BILLING_APP_STORE_PRODUCT_ID_STARTER=
BILLING_APP_STORE_PRODUCT_ID_PRO=
BILLING_APP_STORE_PRODUCT_ID_ENTERPRISE=
